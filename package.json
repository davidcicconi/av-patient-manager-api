{
  "name": "av-patient-manager-api",
  "version": "1.0.0",
  "description": "",
  "main": "index.ts",
  "scripts": {
    "build": "tsc",
    "build:tsoa": "tsc && tsoa spec-and-routes",
    "tsoa": "tsoa spec && tsoa routes",
    "start": "nodemon --watch src --ext ts --exec \"node --inspect=9229 -r ts-node/register\" src/server.ts",
    "dev": "tsoa spec-and-routes && nodemon --watch src --ext ts --exec \"node --inspect=9229 -r ts-node/register\" src/server.ts",
    "typeorm": "ts-node -r reflect-metadata ./node_modules/typeorm/cli.js -d src/infrastructure/database/datasource.ts",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert",
    "migration:generate": "npm run typeorm -- migration:generate",
    "migration:create": "typeorm migration:create",
    "seed:role": "ts-node -r reflect-metadata src/infrastructure/database/seeds/role.seed.ts",
    "seed:admin": "ts-node -r reflect-metadata src/infrastructure/database/seeds/admin.seed.ts",
    "seed:all": "ts-node -r reflect-metadata src/infrastructure/database/seeds/seedAll.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/davidcicconi/av-patient-manager.api.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/davidcicconi/av-patient-manager.api/issues"
  },
  "homepage": "https://github.com/davidcicconi/av-patient-manager.api#readme",
  "dependencies": {
    "@types/joi": "^17.2.2",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "helmet": "^8.1.0",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "mysql2": "^3.23.2",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "^7.0.0-alpha.0",
    "tsyringe": "^4.10.0",
    "typeorm": "^1.1.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.3.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.0.1",
    "eslint-config-prettier": "^10.1.8",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
